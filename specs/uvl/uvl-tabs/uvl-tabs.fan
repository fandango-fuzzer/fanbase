# Same as uvl, indented with tabs: one tab for each level of the tree.

include("uvl/uvl.fan")

<in1> ::= "\t"
<in2> ::= "\t\t"
<in3> ::= "\t\t\t"
<in4> ::= "\t\t\t\t"
<in5> ::= "\t\t\t\t\t"
<in6> ::= "\t\t\t\t\t\t"
<in7> ::= "\t\t\t\t\t\t\t"
<in8> ::= "\t\t\t\t\t\t\t\t"
<in9> ::= "\t\t\t\t\t\t\t\t\t"
