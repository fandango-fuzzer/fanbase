# MP3: an ID3v2.3 tag of three to six text frames, then eleven MPEG audio
# frames, one of each kind (MPEG-1 Layers I, II and III, MPEG-2 and 2.5
# Layer III, 32 to 320 kbit/s, mono, stereo, joint and dual channel, a padded
# frame and one with a CRC), then an ID3v1 tag. The ID3v2 sizes are where
# constraints.
#
# TODO:
# * Frame bodies are zeros, so what varies is the tags: generate the side
#   information and the main data.
# * The frames always come in the same order.

# Top level: ID3v2 tag, a run of audio frames, ID3v1 tag.
<start> ::= <id3v2> <frames> <id3v1>

<frames> ::= <frame>

# One frame of each kind in one stream (a stream may change its settings from
# frame to frame). A sequence and not a repeated choice: each kind has its own
# length constraint, and a repeated choice among them is slow to generate.
<frame> ::= <f_m1_l3_128_44_stereo> <f_m1_l3_128_44_pad> \
            <f_m1_l3_320_48_joint> <f_m1_l3_64_32_mono> \
            <f_m1_l3_128_48_dual> <f_m1_l2_128_44_stereo> \
            <f_m1_l1_256_44_stereo> <f_m2_l3_64_22_stereo> \
            <f_m2_l3_32_16_mono> <f_m25_l3_32_11_mono> \
            <f_m1_l3_192_44_crc>

# Audio frames: a fixed header for each kind, then a body of the length the
# header implies (the frame size minus 4, minus 2 more with a CRC)

# MPEG-1 Layer III, 128 kbps, 44100 Hz, stereo, no pad -> frame 417, body 413.
<f_m1_l3_128_44_stereo> ::= <h_m1_l3_128_44_stereo> <b413>
<h_m1_l3_128_44_stereo> ::= b'\xff\xfa\x90\x04'
where len(bytes(<b413>)) == 413

# Same, padding bit set -> frame 418, body 414.
<f_m1_l3_128_44_pad> ::= <h_m1_l3_128_44_pad> <b414>
<h_m1_l3_128_44_pad> ::= b'\xff\xfa\x92\x04'
where len(bytes(<b414>)) == 414

# MPEG-1 Layer III, 320 kbps, 48000 Hz, joint stereo -> frame 960, body 956.
<f_m1_l3_320_48_joint> ::= <h_m1_l3_320_48_joint> <b956>
<h_m1_l3_320_48_joint> ::= b'\xff\xfa\xe4\x60'
where len(bytes(<b956>)) == 956

# MPEG-1 Layer III, 64 kbps, 32000 Hz, mono, emphasis CCITT -> frame 288, body 284.
<f_m1_l3_64_32_mono> ::= <h_m1_l3_64_32_mono> <b284>
<h_m1_l3_64_32_mono> ::= b'\xff\xfa\x58\xcd'
where len(bytes(<b284>)) == 284

# MPEG-1 Layer III, 128 kbps, 48000 Hz, dual channel -> frame 384, body 380.
<f_m1_l3_128_48_dual> ::= <h_m1_l3_128_48_dual> <b380>
<h_m1_l3_128_48_dual> ::= b'\xff\xfa\x94\x87'
where len(bytes(<b380>)) == 380

# MPEG-1 Layer II, 128 kbps, 44100 Hz, stereo -> frame 417, body 413.
<f_m1_l2_128_44_stereo> ::= <h_m1_l2_128_44_stereo> <b413>
<h_m1_l2_128_44_stereo> ::= b'\xff\xfc\x80\x04'
where len(bytes(<b413>)) == 413

# MPEG-1 Layer I, 256 kbps, 44100 Hz, stereo -> frame 276, body 272.
<f_m1_l1_256_44_stereo> ::= <h_m1_l1_256_44_stereo> <b272>
<h_m1_l1_256_44_stereo> ::= b'\xff\xfe\x80\x04'
where len(bytes(<b272>)) == 272

# MPEG-2 Layer III, 64 kbps, 22050 Hz, stereo -> frame 208, body 204.
<f_m2_l3_64_22_stereo> ::= <h_m2_l3_64_22_stereo> <b204>
<h_m2_l3_64_22_stereo> ::= b'\xff\xf2\x80\x04'
where len(bytes(<b204>)) == 204

# MPEG-2 Layer III, 32 kbps, 16000 Hz, mono -> frame 144, body 140.
<f_m2_l3_32_16_mono> ::= <h_m2_l3_32_16_mono> <b140>
<h_m2_l3_32_16_mono> ::= b'\xff\xf2\x48\xc4'
where len(bytes(<b140>)) == 140

# MPEG-2.5 Layer III, 32 kbps, 11025 Hz, mono -> frame 208, body 204.
<f_m25_l3_32_11_mono> ::= <h_m25_l3_32_11_mono> <b204>
<h_m25_l3_32_11_mono> ::= b'\xff\xe2\x40\xc4'
where len(bytes(<b204>)) == 204

# MPEG-1 Layer III, 192 kbps, 44100 Hz, stereo, with a CRC -> frame 626.
# Layout: header(4) + CRC-16(2) + side info(32, stereo L3) + main data(588).
# The CRC-16 covers the last two header bytes plus the side information.
<f_m1_l3_192_44_crc> ::= <h_m1_l3_192_44_crc> <crc16> <sideinfo32> <b588>
<h_m1_l3_192_44_crc> ::= b'\xff\xfb\xb0\x04'
# CRC-16 (poly 0x8005, init 0xFFFF) of header bytes 3 and 4 and the 32 bytes
# of side information, all fixed here: 0xC1C1
<crc16> ::= b'\xc1\xc1'
<sideinfo32> ::= b'\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'
where len(bytes(<sideinfo32>)) + len(bytes(<b588>)) == 620

# Frame bodies: zeros, each one literal
<b140> ::= b'\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'
<b204> ::= b'\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'
<b272> ::= b'\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'
