# ID3v2.3 tag: "ID3", version 3.0, flags, and the size of the frames as a
# 28-bit synchsafe integer (7 bits in each byte); then text frames: id, size
# (u32), flags (2 bytes), encoding 0 (ISO-8859-1) and the text
<id3v2> ::= b'ID3' b'\x03\x00' b'\x00' <id3_size> <id3_body>
<id3_size> ::= <byte>{4}
<id3_body> ::= <id3_frame>{3,6}
where <id3_size> == bytes([ (len(bytes(<id3_body>)) >> 21) & 0x7f, \
                            (len(bytes(<id3_body>)) >> 14) & 0x7f, \
                            (len(bytes(<id3_body>)) >> 7) & 0x7f, \
                            len(bytes(<id3_body>)) & 0x7f ])

<id3_frame> ::= <id3_fid> <id3_fsize> b'\x00\x00' <id3_fcontent>
<id3_fid> ::= 'TIT2' | 'TPE1' | 'TALB' | 'TYER' | 'TRCK' | 'TCON' | 'TENC' | 'TCOM'
<id3_fcontent> ::= b'\x00' <id3_ftext>
<id3_ftext> ::= r'[ -~]{1,24}'
<id3_fsize> ::= <byte>{4}
where <id3_fsize> == len(bytes(<id3_fcontent>)).to_bytes(4, 'big')

# ID3v1 tag, 128 bytes: "TAG", title, artist and album (30 each), year (4),
# comment (30), genre (1)
<id3v1> ::= b'TAG' <v1_title> <v1_artist> <v1_album> <v1_year> <v1_comment> <v1_genre>
<v1_title>   ::= <v1_text30>
<v1_artist>  ::= <v1_text30>
<v1_album>   ::= <v1_text30>
<v1_comment> ::= <v1_text30>
<v1_year> ::= r'[0-9]{4}'
<v1_genre> ::= <byte>
<v1_text30> ::= r'[ -~]{30}'

# bytes
<byte> ::= rb'[\x00-\xff]'
