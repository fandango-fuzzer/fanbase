# Same X11/X10 dialects as xbm, with the surrounding C lexical detail varied
# instead of the geometry: identifier stems, block comments and whitespace
# between tokens, char/unsigned-char/short/unsigned-short element types,
# variable-width hex literals and an optional trailing comma.
#
# The number of elements has to be exactly right for the size, and the three names
# have to be one stem. Both asked of a search (a constraint on random sizes of up to
# 2^32 and on three random identifiers) take minutes for some seeds and never come
# for others. So the sizes are the ones of xbm (8, 16, 24 and 32 by 8, 16, 24 and 32),
# the stem is one of a few, and each combination has its own alternative, with the
# sizes and the number of elements written in it.

<start> ::= <x11_without_hotspot> | <x11_with_hotspot> | <x10_without_hotspot> | <x10_with_hotspot>

<x11_without_hotspot> ::= <x11_without_hotspot_s0> | <x11_without_hotspot_s1> | <x11_without_hotspot_s2> | <x11_without_hotspot_s3>
<x11_without_hotspot_s0> ::= <x11_without_hotspot_s0_w8> | <x11_without_hotspot_s0_w16> | <x11_without_hotspot_s0_w24> | <x11_without_hotspot_s0_w32>
