# shared tokens
<ws>     ::= r'[ \t\r\n]+'
<onews>  ::= "\n"
<comments> ::= <comment>*
<comment>  ::= r'#[^\n\r]*' "\n"
<byte>     ::= rb'[\x00-\xff]'
<p3sample> ::= <p3num> " "
<p3num>    ::= r'0|[1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-5]'
